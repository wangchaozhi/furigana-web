# Local non-Docker development
DB_PATH=./data/furigana.sqlite3
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Vercel API mode (leave unset for the original local SQLite mode)
DATABASE_URL=
SKIP_DB_INIT=false
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional only for Supabase projects still using legacy HS256 JWT signing.
SUPABASE_JWT_SECRET=
LOCAL_USER_ID=local
LOCAL_USER_EMAIL=local@furigana.invalid
CORS_ORIGIN_REGEX=

# Vercel Web mode (public browser values; never put the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional automatic Chinese/English translation (API server only)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra

# Optional modular translation providers (configure any combination)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET=
YOUDAO_TRANSLATE_APP_KEY=
YOUDAO_TRANSLATE_SECRET=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
